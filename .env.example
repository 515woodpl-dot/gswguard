# Copy to .env.local for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gswguard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
RESEND_API_KEY=replace-me
GOOGLE_DRIVE_SHARED_DRIVE_ID=replace-me
BOOTSTRAP_EMAIL=replace-me
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Explicit browser origins. Never use * with credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep 0 when directly exposed. Set to the exact number of trusted proxies
# only when infrastructure overwrites X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
