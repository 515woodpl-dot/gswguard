# YorGuard environment reference. Never commit real values.
#
# Split into two local files so a secret cannot reach the dashboard container
# by default (see docker-compose.yml):
#
#   .env.local          shared, non-secret config    -> api + dashboard
#   .env.secrets.local  API-only secrets             -> api only
#
# Both are gitignored. Copy the sections below into the matching file.
# Every variable listed here is read by real code; nothing here is aspirational.


# =============================================================================
# .env.local  - shared, non-secret. Given to BOTH containers.
# =============================================================================

# Read by the API (apps/api/app/config.py).
APP_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=0.1.0

# Supabase JWT validation. Issuer is required when APP_ENV=production; a
# trailing slash is tolerated and stripped. When SUPABASE_JWT_JWKS_URL is unset
# it is derived as "<issuer>/.well-known/jwks.json" and used for ES256 tokens.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Explicit browser origins for the API. Never use * with credentialed requests.
# In production this must be the dashboard's Tailscale Serve origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep 0 when the API is reached directly or through a loopback proxy that does
# NOT rewrite X-Forwarded-For (Tailscale Serve does not). Set it to the exact
# number of trusted proxies only when infrastructure overwrites the header.
TRUSTED_PROXY_HOPS=0

# Read by the dashboard (apps/dashboard/app/api/runtime-config/route.ts) and
# returned to the browser. The anon key is public by design; tenant isolation
# for any direct-to-Postgres access rests on Supabase RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
API_BASE_URL=http://localhost:8000

# Immutable signed release the Windows bootstrap pins to, and the release
# signing public key it verifies the manifest against. Both must be set or the
# dashboard refuses to generate a bootstrap script. The key must match the one
# pinned in scripts/YorGuardIntegrity.ps1.
AGENT_RELEASE_REF=v0.1.1
AGENT_SIGNING_PUBLIC_KEY_XML_BASE64=replace-me


# =============================================================================
# .env.secrets.local  - API only. Never given to the dashboard.
# =============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gswguard

# Server-only HS256 verification key. Never sent to a browser or an agent.
SUPABASE_JWT_SECRET=replace-me

# Not read by any current code path. Kept out of the dashboard so it cannot be
# exposed by a Next.js server-side flaw. Remove it once Drive/Resend delivery is
# scoped, or wire it deliberately at that point.
# SUPABASE_SERVICE_ROLE_KEY=replace-me
